{
  "name": "cinemate",
  "version": "0.1.0",
  "description": "Tinder pentru filme/seriale — swipe, match live, solo mode. Cloudflare Workers + D1 + Durable Objects + KV.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate:local": "wrangler d1 execute cinemate-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute cinemate-db --remote --file=schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "wrangler": "^3.95.0"
  }
}
